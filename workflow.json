    {
      "type": "textfield",
      "variable": "tr_more",
      "label": "Also translate into",
      "description": "Extra languages shown below the translation, separated by commas: codes or names (fr, ja, Spanish).",
      "config": {
        "default": "",
        "placeholder": "fr, ja",
        "required": false,
        "trim": true
      }
    },
    {
      "type": "popupbutton",
      "variable": "tr_enter",
      "label": "↩ Return",
      "description": "⌘↩ does the other one.",
      "config": {
        "default": "copy",
        "pairs": [
          [
            "Copies the translation",
            "copy"
          ],
          [
            "Pastes the translation",
            "paste"
          ]
        ]
      }
    },
    {
      "type": "checkbox",
      "variable": "tr_details",
      "label": "Details",
      "description": "From Google Translate, for words and short phrases.",
      "config": {
        "default": true,
        "required": false,
        "text": "Show dictionary meanings, alternatives, definitions and examples"
      }
    },
    {
      "type": "checkbox",
      "variable": "tr_clipboard",
      "label": "Clipboard",
      "description": "Only plain text; passwords marked as concealed by password managers are skipped.",
      "config": {
        "default": true,
        "required": false,
        "text": "Translate the clipboard when nothing is typed"
      }
    },
    {
      "type": "popupbutton",
      "variable": "tr_history",
      "label": "History",
      "description": "Translations you copy, paste or speak.",
      "config": {
        "default": "100",
        "pairs": [
          [
            "Keep the last 100 translations",
            "100"
          ],
          [
            "Keep the last 500 translations",
            "500"
          ],
          [
            "Don’t keep a history",
            "0"
          ]
        ]
      }
    },
    {
      "type": "popupbutton",
      "variable": "tr_speech",
      "label": "Speech (⌃↩)",
      "description": "macOS voices work offline; add more in System Settings › Accessibility › Spoken Content.",
      "config": {
        "default": "auto",
        "pairs": [
          [
            "macOS voice, or Google’s voice when none is installed",
            "auto"
          ],
          [
            "macOS voices only",
            "macos"
          ],
          [
            "Google’s voice",
            "google"
          ]
        ]
      }
    },
    {
      "type": "popupbutton",
      "variable": "tr_deepl_formality",
      "label": "DeepL formality",
      "description": "For languages that have formal and informal forms (German, French, Japanese…).",
      "config": {
        "default": "default",
        "pairs": [
          [
            "Default",
            "default"
          ],
          [
            "More formal",
            "prefer_more"
          ],
          [
            "Less formal",
            "prefer_less"
          ]
        ]
      }
    },
    {
      "type": "popupbutton",
      "variable": "tr_deepl_english",
      "label": "DeepL English",
      "description": "",
      "config": {
        "default": "EN-US",
        "pairs": [
          [
            "American English",
            "EN-US"
          ],
          [
            "British English",
            "EN-GB"
          ]
        ]
      }
    }
  ],
  "objects": [
    {
      "id": "sf_translate",
      "type": "scriptfilter",
      "keyword": "{var:keyword_translate}",
      "title": "Translate",
      "subtext": "Type text, or leave it empty to translate the clipboard",
      "running": "Translating…",
      "script": "tr_query=$1 exec /usr/bin/osascript -l JavaScript ./translate.js filter",
      "queuedelaymode": 1,
      "queuemode": 2,
      "note": "The query goes through the environment (it can hold an API key after “apikey”)"
    },
    {
      "id": "sf_history",
      "type": "scriptfilter",
      "keyword": "{var:keyword_history}",
      "title": "Recent Translations",
      "subtext": "Search the translations you copied, pasted or spoke",
      "script": "tr_query=$1 exec /usr/bin/osascript -l JavaScript ./translate.js history"
    },
    {
      "id": "ua_translate",
      "type": "universalaction",
      "name": "Translate Text",
      "text": true
    },
    {
      "id": "hk_translate",
      "type": "hotkey",
      "argument": 1,
      "note": "Configure a Hotkey to translate the selected text"
    },
    {
      "id": "ua_replace",
      "type": "universalaction",
      "name": "Translate and Replace",
      "text": true
    },
    {
      "id": "hk_replace",
      "type": "hotkey",
      "argument": 1,
      "note": "Configure a Hotkey to replace the selected text with its translation"
    },
    {
      "id": "instant",
      "type": "script",
      "script": "tr_query=$1 exec /usr/bin/osascript -l JavaScript ./translate.js instant",
      "note": "Translates the selection for pasting over it"
    },
    {
      "id": "act",
      "type": "script",
      "script": "exec /usr/bin/osascript -l JavaScript ./translate.js act \"$1\"",
      "note": "Copy, paste, speak, open, swap, history and API key; sets tr_route"
    },
    {
      "id": "route",
      "type": "conditional",
      "conditions": [
        {
          "id": "copy",
          "input": "{var:tr_route}",
          "mode": 0,
          "match": "copy",
          "label": "Copy"
        },
        {
          "id": "paste",
          "input": "{var:tr_route}",
          "mode": 0,
          "match": "paste",
          "label": "Paste"
        }
      ],
      "elselabel": "Message",
      "note": "tr_route from the action: copy, paste, or a message for the notification"
    },
    {
      "id": "copy",
      "type": "clipboard",
      "autopaste": false
    },
    {
      "id": "paste",
      "type": "clipboard",
      "autopaste": true
    },
    {
      "id": "notify",
      "type": "notification"
    }
  ],
  "connections": [
    {
      "from": "ua_translate",
      "to": "sf_translate"
    },
    {
      "from": "hk_translate",
      "to": "sf_translate"
    },
    {
      "from": "ua_replace",
      "to": "instant"
    },
    {
      "from": "hk_replace",
      "to": "instant"
    },
    {
      "from": "sf_translate",
      "to": "act"
    },
    {
      "from": "sf_translate",
      "to": "act",
      "mod": "cmd"
    },
    {
      "from": "sf_translate",
      "to": "act",
      "mod": "alt"
    },
    {
      "from": "sf_translate",
      "to": "act",
      "mod": "ctrl"
    },
    {
      "from": "sf_translate",
      "to": "act",
      "mod": "shift"
    },
    {
      "from": "sf_history",
      "to": "act"
    },
    {
      "from": "sf_history",
      "to": "act",
      "mod": "cmd"
    },
    {
      "from": "sf_history",
      "to": "act",
      "mod": "alt"
    },
    {
      "from": "sf_history",
      "to": "act",
      "mod": "ctrl"
    },
    {
      "from": "sf_history",
      "to": "act",
      "mod": "shift"
    },
    {
      "from": "act",
      "to": "route"
    },
    {
      "from": "instant",
      "to": "route"
    },
    {
      "from": "route",
      "to": "copy",
      "output": "copy"
    },
    {
      "from": "route",
      "to": "paste",
      "output": "paste"
    },
    {
      "from": "route",
      "to": "notify"
    }
  ]
}
